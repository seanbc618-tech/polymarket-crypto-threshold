# Direct-connect VPS configuration for seven-asset 5m/15m Up/Down research.
# Install as /etc/polymarket-crypto-updown.env with mode 0640.

DATABASE_PATH=/opt/polymarket-crypto-threshold/data/updown-shadow.db

# Hard safety boundary. This process accepts no wallet or signing secrets.
TRADING_DISABLED=true
POLYMARKET_STREAM_USER_CHANNEL_ENABLED=false

# Public Polymarket and CEX reads only.
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com
POLYMARKET_SITE_API_BASE=https://polymarket.com/api
POLYMARKET_STREAM_ENABLED=true
POLYMARKET_STREAM_SHADOW_MODE=true
CHAINLINK_REFERENCE_STREAM_ENABLED=false
BINANCE_REFERENCE_STREAM_ENABLED=false

# This contract family settles on Chainlink BTC/ETH/SOL/XRP/DOGE/BNB/HYPE USD.
SHADOW_ENABLED=true
SHADOW_CONTRACT_FAMILY=short_updown
SHADOW_INTERVAL_SECONDS=10
SHADOW_DISCOVERY_LIMIT=50
SHADOW_ANALYSIS_LIMIT=14
SHADOW_SETTLEMENT_LIMIT=50
PAPER_MIN_NET_EV=0.02

# The Hong Kong VPS connects directly. Never copy a local loopback proxy here.
BINANCE_STREAM_PROXY_URL=

# A sealed logistic model predicts the final Chainlink Up/Down label from
# Binance spot 1m candles closed at T-60s. HYPE has no Binance spot pair and
# therefore remains fail-closed in this first strategy.
SHORT_CEX_MODEL_PATH=/opt/polymarket-crypto-threshold/data/models/cex-direction-v1.json
SHORT_CEX_MIN_REMAINING_SECONDS=10
SHORT_CEX_MAX_CHECKPOINT_LAG_SECONDS=50

# R0 uses the sealed v4 model as an unchanged reference at four declared
# checkpoints. Each selected paper side is resampled from the public CLOB at
# the fixed latency grid; all evidence stays in separate challenger tables.
SHORT_CHALLENGER_ENABLED=true
SHORT_CHALLENGER_CHECKPOINTS_SECONDS=180,120,60,30
SHORT_CHALLENGER_LATENCIES_MS=0,100,250,500,1000
SHORT_CHALLENGER_MIN_REMAINING_SECONDS=5

# Chainlink RTDS is not a prediction input. Final settlement still independently
# requires the completed Chainlink window plus matching Gamma metadata/outcome.
CHAINLINK_REFERENCE_STREAM_STALE_SECONDS=5
CHAINLINK_REFERENCE_STREAM_HISTORY_SECONDS=1200
CHAINLINK_REFERENCE_STREAM_MAX_TICKS_PER_PAIR=2000
CHAINLINK_VOLATILITY_WINDOW_SECONDS=900
CHAINLINK_VOLATILITY_SAMPLE_SECONDS=30

# REST is authoritative for token-specific depth and fee schedules.
MAX_BOOK_AGE_SECONDS=90
ANALYSIS_SIZE_USDC=10
HTTP_TIMEOUT_SECONDS=20
