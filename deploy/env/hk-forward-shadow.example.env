# Direct-connect VPS configuration for forward daily-label collection.
# Install as /etc/polymarket-crypto-forward.env with mode 0640.

DATABASE_PATH=/opt/polymarket-crypto-threshold/data/phase2-forward.db

# Hard safety boundary. This process accepts no wallet or signing secrets.
TRADING_DISABLED=true
POLYMARKET_STREAM_USER_CHANNEL_ENABLED=false

# Public REST providers and official public stream clients only.
PRICE_PRIMARY_PROVIDER=binance
PRICE_SECONDARY_PROVIDER=coinbase
POLYMARKET_STREAM_ENABLED=true
POLYMARKET_STREAM_SHADOW_MODE=true
BINANCE_REFERENCE_STREAM_ENABLED=true

# This continuation only collects daily-threshold research evidence.
SHADOW_ENABLED=true
SHADOW_CONTRACT_FAMILY=daily_threshold
SHADOW_INTERVAL_SECONDS=900
SHADOW_DISCOVERY_LIMIT=20
SHADOW_ANALYSIS_LIMIT=20
PAPER_MIN_NET_EV=0.02

# The Hong Kong VPS connects directly. Never copy a local loopback proxy here.
BINANCE_STREAM_PROXY_URL=

# REST remains authoritative for executable depth and all model inputs.
MAX_BOOK_AGE_SECONDS=90
MAX_PRICE_AGE_SECONDS=120
ANALYSIS_SIZE_USDC=10
HTTP_TIMEOUT_SECONDS=20
