# Direct-connect VPS configuration for Phase 2 read-only evidence collection.
# Install as /etc/polymarket-crypto-threshold.env with mode 0640.

DATABASE_PATH=/opt/polymarket-crypto-threshold/data/phase2-vps.db

# Hard safety boundary. The VPS must not receive wallet or signing secrets.
TRADING_DISABLED=true
POLYMARKET_STREAM_USER_CHANNEL_ENABLED=false

# Public REST providers and official public stream clients only.
PRICE_PRIMARY_PROVIDER=binance
PRICE_SECONDARY_PROVIDER=coinbase
POLYMARKET_STREAM_ENABLED=true
POLYMARKET_STREAM_SHADOW_MODE=true
BINANCE_REFERENCE_STREAM_ENABLED=true

# The Hong Kong VPS connects directly. Never copy the local macOS proxy here.
BINANCE_STREAM_PROXY_URL=

# Formal Phase 2 evidence cadence. The unit adds a one-hour wall-clock guard
# band so persisted cycle coverage can still exceed the 72-hour evidence gate.
SHADOW_ENABLED=true
SHADOW_INTERVAL_SECONDS=180
SHADOW_DISCOVERY_LIMIT=20
SHADOW_ANALYSIS_LIMIT=10
PAPER_MIN_NET_EV=0.02

# REST remains authoritative for executable depth and all model inputs.
MAX_BOOK_AGE_SECONDS=90
MAX_PRICE_AGE_SECONDS=120
ANALYSIS_SIZE_USDC=10
HTTP_TIMEOUT_SECONDS=20
