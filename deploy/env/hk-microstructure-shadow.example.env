# Direct-connect VPS configuration for isolated R1/R2/R3 CEX research.
# Install as /etc/polymarket-crypto-microstructure.env with mode 0640.

# This database is independent from Daily Forward and short Up/Down evidence.
MICROSTRUCTURE_DATABASE_PATH=/opt/polymarket-crypto-threshold/data/microstructure-shadow.db
MICROSTRUCTURE_ENABLED=true
MICROSTRUCTURE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT

# Hard safety boundary: this process has no order or wallet surface.
TRADING_DISABLED=true

# Public Binance REST and official public WebSocket only.
BINANCE_API_BASE=https://api.binance.com/api/v3
BINANCE_FUTURES_API_BASE=https://fapi.binance.com/fapi/v1
BINANCE_STREAM_URL=wss://stream.binance.com:443
BINANCE_STREAM_PROXY_URL=

# Capture and gate cadence. The service is bounded to two hours per run.
MICROSTRUCTURE_POLL_SECONDS=0.25
MICROSTRUCTURE_SNAPSHOT_SECONDS=60
# Raw L2/tick persistence remains continuous. Derived features run every ten
# seconds so the VPS stays below feed rate even near a full snapshot interval.
MICROSTRUCTURE_FEATURE_SECONDS=10
MICROSTRUCTURE_INTEGRITY_SECONDS=300
MICROSTRUCTURE_PURGE_SECONDS=600
MICROSTRUCTURE_EMBARGO_SECONDS=300
MICROSTRUCTURE_DEPTH_LEVELS=5
MICROSTRUCTURE_TRADE_LOOKBACK_SECONDS=5
MICROSTRUCTURE_EVENT_BATCH_LIMIT=50000
MICROSTRUCTURE_INTEGRITY_SAMPLE_LIMIT=500
MICROSTRUCTURE_STREAM_STALE_SECONDS=30
MICROSTRUCTURE_STREAM_READY_TIMEOUT_SECONDS=30
MICROSTRUCTURE_STREAM_MAX_EVENTS=200000
MICROSTRUCTURE_FROZEN_MODEL_VERSION=cex-kline-chainlink-direction-v1+49093373ec3e
MICROSTRUCTURE_DURATION_HOURS=2
