DATABASE_PATH=crypto_threshold.db
TRADING_DISABLED=true

# Optional local wallet configuration. Store the private key in macOS Keychain
# through the Dashboard; never put a real private key in this file.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=

POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com
BINANCE_API_BASE=https://api.binance.com/api/v3
# Required on the current local development network; Hiddify uses the value
# below. Leave blank on a directly connected VPS and do not copy loopback
# proxy settings into server configuration. Generic HTTP_PROXY/HTTPS_PROXY are
# not consumed by the official Binance WebSocket SDK path.
BINANCE_STREAM_PROXY_URL=
COINBASE_API_BASE=https://api.coinbase.com/v2

PRICE_PRIMARY_PROVIDER=binance
PRICE_SECONDARY_PROVIDER=coinbase
PRICE_CROSSCHECK_MAX_DIFF=0.005
MAX_BOOK_AGE_SECONDS=90
MAX_PRICE_AGE_SECONDS=120
ANALYSIS_SIZE_USDC=10
HTTP_TIMEOUT_SECONDS=20

# Opt-in read-only Phase 2 monitoring. Keep every stream in shadow/public mode.
SHADOW_ENABLED=false
SHADOW_CONTRACT_FAMILY=daily_threshold
SHADOW_INTERVAL_SECONDS=180
SHADOW_DISCOVERY_LIMIT=20
SHADOW_ANALYSIS_LIMIT=10
PAPER_MIN_NET_EV=0.02
POLYMARKET_STREAM_ENABLED=false
POLYMARKET_STREAM_SHADOW_MODE=true
POLYMARKET_STREAM_USER_CHANNEL_ENABLED=false
BINANCE_REFERENCE_STREAM_ENABLED=false
BINANCE_REFERENCE_STREAM_STALE_SECONDS=45
BINANCE_REFERENCE_STREAM_MAX_TICK_SLOTS=16
CHAINLINK_REFERENCE_STREAM_ENABLED=false
CHAINLINK_REFERENCE_STREAM_STALE_SECONDS=5
CHAINLINK_REFERENCE_STREAM_HISTORY_SECONDS=1200
CHAINLINK_REFERENCE_STREAM_MAX_TICKS_PER_PAIR=2000
CHAINLINK_BOUNDARY_TOLERANCE_SECONDS=2
CHAINLINK_VOLATILITY_WINDOW_SECONDS=900
CHAINLINK_VOLATILITY_SAMPLE_SECONDS=30

# Exact HTTPS origin only for a read-only dashboard behind a trusted external
# access boundary. Public-origin mode disables all wallet setup routes.
DASHBOARD_PUBLIC_ORIGIN=
